{
  "name": "carevault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:unit": "jest --coverage --coverageDirectory=coverage/unit __tests__/unit",
    "test:usecase": "jest --coverage --coverageDirectory=coverage/usecase __tests__/usecase",
    "test:state-transition": "jest --coverage --coverageDirectory=coverage/state-transition __tests__/state-transition",
    "test:combinatorial": "jest --coverage --coverageDirectory=coverage/combinatorial __tests__/combinatorial",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:unit && npm run test:usecase && npm run test:state-transition && npm run test:combinatorial && npm run test:e2e",
    "coverage:merge": "node scripts/merge-coverage.js",
    "coverage:all": "npm run test:unit && npm run test:usecase && npm run test:state-transition && npm run test:combinatorial && npm run coverage:merge"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@supabase/supabase-js": "^2.90.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.400.0",
    "next": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0"
  }
}
